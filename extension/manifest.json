{
  "manifest_version": 3,
  "name": "FormGuard – Private Form Error Helper",
  "short_name": "FormGuard",
  "version": "1.0.0",
  "description": "Explains form errors in plain language and helps with file uploads — entirely on your device.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "FormGuard — click to check this page",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
